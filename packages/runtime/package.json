{
  "name": "@ykdz/reins",
  "version": "0.2.0",
  "private": true,
  "description": "A deliberately simple harness control plane.",
  "keywords": [
    "agent",
    "codex",
    "harness",
    "qoder"
  ],
  "homepage": "https://github.com/YKDZ/reins#readme",
  "bugs": {
    "url": "https://github.com/YKDZ/reins/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/reins.git"
  },
  "bin": {
    "reins-daemon": "./dist/reins-daemon.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "type": "module",
  "exports": {
    "./application": {
      "source": "./src/application.ts",
      "types": "./dist/application.d.ts",
      "default": "./dist/application.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@reins/protocol": "workspace:*",
    "@reins/transport": "workspace:*",
    "@ykdz/reins-sdk": "workspace:*",
    "proper-lockfile": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@reins/daemon": "workspace:*",
    "@reins/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rolldown": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "dependenciesMeta": {
    "@reins/daemon": {
      "injected": false
    },
    "@reins/protocol": {
      "injected": false
    },
    "@reins/transport": {
      "injected": false
    },
    "@ykdz/reins-sdk": {
      "injected": false
    }
  },
  "engines": {
    "node": ">=24"
  }
}
