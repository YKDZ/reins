{
  "name": "@reins/daemon",
  "private": true,
  "bin": {
    "reins-daemon": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "postbuild": "node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "test": "vitest run test/unit --reporter=agent",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@reins/adapter-kit": "workspace:*",
    "@reins/codex": "workspace:*",
    "@reins/core": "workspace:*",
    "@reins/protocol": "workspace:*",
    "@reins/qoder": "workspace:*",
    "@reins/transport": "workspace:*",
    "proper-lockfile": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@reins/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "dependenciesMeta": {
    "@reins/adapter-kit": {
      "injected": false
    },
    "@reins/codex": {
      "injected": false
    },
    "@reins/core": {
      "injected": false
    },
    "@reins/protocol": {
      "injected": false
    },
    "@reins/qoder": {
      "injected": false
    },
    "@reins/transport": {
      "injected": false
    }
  },
  "engines": {
    "node": "24"
  }
}
