{
  "concurrency": "50%",
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["client", "protocol", "transport", "library"]
        }
      },
      "adapter": {
        "dependencies": {
          "allow": ["protocol", "adapter-kit", "library"]
        }
      },
      "adapter-kit": {
        "dependencies": {
          "allow": ["protocol", "library"]
        }
      },
      "core": {
        "dependencies": {
          "allow": ["protocol", "library"]
        }
      },
      "client": {
        "dependencies": {
          "allow": ["client", "protocol", "transport", "library"]
        }
      },
      "conformance": {
        "dependencies": {
          "allow": [
            "adapter",
            "adapter-kit",
            "client",
            "core",
            "daemon",
            "event-journal",
            "protocol",
            "transport",
            "library"
          ]
        }
      },
      "daemon": {
        "dependencies": {
          "allow": [
            "protocol",
            "core",
            "adapter",
            "adapter-kit",
            "event-journal",
            "transport",
            "library"
          ]
        }
      },
      "event-journal": {
        "dependencies": {
          "allow": ["protocol", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "protocol": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "transport": {
        "dependencies": {
          "allow": ["protocol", "library"]
        }
      }
    }
  },
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"],
  "tasks": {
    "//#boundaries": {
      "cache": false
    },
    "//#language": {
      "cache": false
    },
    "//#format:check": {
      "outputs": []
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"]
    },
    "//#lint": {
      "outputs": []
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#typecheck": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "deployment": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "format:write": {
      "cache": false,
      "dependsOn": ["lint:fix"]
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "//#release:build": {
      "cache": false,
      "dependsOn": ["@ykdz/reins#build", "@reins/daemon#build"]
    },
    "//#release:verify": {
      "cache": false,
      "dependsOn": ["//#release:build"]
    },
    "//#release:npm-smoke": {
      "cache": false,
      "dependsOn": ["//#release:verify"]
    }
  }
}
