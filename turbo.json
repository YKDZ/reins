{
  "concurrency": "50%",
  "boundaries": {
    "tags": {
      "runtime": {
        "dependencies": {
          "allow": [
            "client",
            "protocol",
            "transport",
            "daemon",
            "core",
            "adapter",
            "adapter-kit",
            "event-journal",
            "library"
          ]
        }
      },
      "adapter": {
        "dependencies": {
          "allow": ["protocol", "adapter-kit", "library"]
        }
      },
      "adapter-kit": {
        "dependencies": {
          "allow": ["protocol", "library"]
        }
      },
      "core": {
        "dependencies": {
          "allow": ["protocol", "library"]
        }
      },
      "client": {
        "dependencies": {
          "allow": ["client", "protocol", "transport", "library"]
        }
      },
      "conformance": {
        "dependencies": {
          "allow": [
            "adapter",
            "adapter-kit",
            "client",
            "core",
            "daemon",
            "event-journal",
            "protocol",
            "transport",
            "library"
          ]
        }
      },
      "daemon": {
        "dependencies": {
          "allow": [
            "protocol",
            "core",
            "adapter",
            "adapter-kit",
            "event-journal",
            "transport",
            "library"
          ]
        }
      },
      "event-journal": {
        "dependencies": {
          "allow": ["protocol", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "protocol": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "transport": {
        "dependencies": {
          "allow": ["protocol", "library"]
        }
      }
    }
  },
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "RUSTUP_HOME",
    "RUSTUP_TOOLCHAIN",
    "TMPDIR",
    "GITHUB_OUTPUT"
  ],
  "tasks": {
    "//#boundaries": {
      "cache": false,
      "tags": ["quality:light"]
    },
    "//#language": {
      "cache": false,
      "tags": ["quality:light"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "format:check": {
      "outputs": []
    },
    "format:write": {
      "cache": false,
      "dependsOn": ["lint:fix"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@ykdz/reins#test:live:codex-contract": {
      "cache": false,
      "dependsOn": ["build"],
      "tags": ["quality:conditional"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "//#release:build": {
      "cache": false,
      "dependsOn": ["@ykdz/reins#build", "@reins/daemon#build"],
      "tags": ["work:preparation"]
    },
    "//#release:verify": {
      "cache": false,
      "dependsOn": ["//#release:build"],
      "tags": ["quality:heavy"]
    },
    "//#check": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#fix": {
      "tags": ["work:repair"],
      "cache": false
    },
    "//#check:heavy": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#check:full": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#test": {
      "tags": ["quality:light"],
      "dependsOn": ["@ykdz/reins#build", "@reins/daemon#build"]
    },
    "//#test:e2e": {
      "tags": ["quality:heavy"],
      "cache": false,
      "dependsOn": ["@ykdz/reins#build", "@reins/daemon#build"]
    },
    "//#test:e2e:qoder-live": {
      "tags": ["quality:conditional"],
      "cache": false,
      "env": ["QODERCLI_PATH"],
      "dependsOn": ["@ykdz/reins#build", "@reins/daemon#build"]
    }
  }
}
