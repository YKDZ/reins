{
  "name": "@reins/qoder",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "migrate:fixtures": "node --conditions=source test/scripts/migrate-fixtures.ts",
    "record:fixture": "node test/scripts/record-fixture.ts",
    "test": "vitest run test --exclude test/live-smoke.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:live": "REINS_LIVE_SMOKE=1 vitest run test/live-smoke.test.ts"
  },
  "dependencies": {
    "@qodercn-ai/qodercn-agent-sdk": "catalog:",
    "@reins/adapter-kit": "workspace:*",
    "@reins/protocol": "workspace:*"
  },
  "devDependencies": {
    "@reins/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "dependenciesMeta": {
    "@reins/adapter-kit": {
      "injected": false
    },
    "@reins/protocol": {
      "injected": false
    }
  },
  "engines": {
    "node": "24"
  }
}
